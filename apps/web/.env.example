VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only (Vercel API routes / Edge functions).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Web Push VAPID keys (generate with: npx web-push generate-vapid-keys)
# Public key: client env (Vite)
